{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dv-agent-framework/agent_output.schema.json",
  "title": "DV Subagent Output Contract v1",
  "type": "object",
  "required": ["contract_version", "agent", "task_id", "status", "summary", "findings", "open_questions", "proposed_actions"],
  "additionalProperties": true,
  "properties": {
    "contract_version": {"const": "dv-agent-output/v1"},
    "agent": {"type": "string", "pattern": "^dv-[a-z0-9-]+$"},
    "task_id": {"type": "string"},
    "status": {"enum": ["ok", "needs_input", "blocked", "failed"]},
    "summary": {"type": "string"},
    "classification": {"enum": ["RTL_DEFECT", "TB_DEFECT", "SVA_DEFECT", "SPEC_AMBIGUITY", "ENV_OR_TOOL_ISSUE", "INTENTIONAL_NEGATIVE_TEST", "NOT_APPLICABLE"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "epistemic", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "topic": {"type": "string"},
          "claim": {"type": "string"},
          "epistemic": {"enum": ["CONFIRMED", "HYPOTHESIS", "UNKNOWN"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source"],
              "properties": {
                "source": {"type": "string", "description": "Project-relative path or tool reference (e.g. p4://@12345, jira://KEY-1)"},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "revision": {"type": "string"},
                "excerpt": {"type": "string"},
                "sim_time": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "description", "requires_approval"],
        "properties": {
          "type": {"enum": ["read", "edit_source", "run_simulation", "run_formal", "run_coverage", "file_ticket", "ask_human"]},
          "description": {"type": "string"},
          "requires_approval": {"type": "boolean"}
        }
      }
    },
    "security_alerts": {"type": "array", "items": {"type": "string"}},
    "review_verdict": {"enum": ["approve", "revise", "reject"]},
    "review_issues": {"type": "array", "items": {"type": "string"}}
  }
}
